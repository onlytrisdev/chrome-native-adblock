<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChromeNativeAdblock.Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChromeNativeAdblock.Gui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E222A" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2E3440" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F" />
            <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="BadgeGreenBrush" Color="#10B981" />
            <SolidColorBrush x:Key="BadgeBlueBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="BadgeRedBrush" Color="#EF4444" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
